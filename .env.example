# -------------------------------------------------------
# Solar Generation Forecasting API — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# Port the API service will listen on (inside the container)
API_PORT=8000

# Path to the trained advanced model artifact (relative to project root)
MODEL_PATH=models/advanced_model.pkl

# Log level for uvicorn (debug | info | warning | error | critical)
LOG_LEVEL=info
